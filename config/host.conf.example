# Host-specific launcher settings.
# Copy this file to config/host.conf and keep host.conf out of Git.

# Root directory containing the actual game binaries and assets.
game_data_root=~/pi-286-game-files

# The launcher always starts its DOSBox session on this authenticated server.
# remote_dosbox_url=http://192.168.100.194:28680
# remote_dosbox_token_file=~/.config/pi286-stream.token
# remote_dosbox_presenter=/opt/pi286/stream/bin/pi286-stream-presenter
remote_dosbox_transport=websocket

# The remote backend applies this before its tile comparison.
video_scaling=crt-lite
# video_scaling=linear-v
# video_scaling=crt-lite

# Raspberry Pi 1 direct-console classic SDL 1.2 build for the presenter.
presenter_ld_library_path=/opt/sdl12-fbcon/lib
presenter_sdl_videodriver=fbcon
presenter_sdl_fbdev=/dev/fb0
presenter_sdl_fb_broken_modes=1

# Persisted HDMI PCM level. The launcher applies it at startup; Left/Right in
# the launcher menu adjust it in 10% steps.
audio_volume_percent=96
# Optional compatibility mode for monitors that stretch a 4:3 HDMI signal.
# Keep 0 for the normal 640x480 path. With 1, SDL centers its unscaled
# 640x480 logical surface in any larger compatible RGB565 framebuffer.
presenter_sdl_fb_pillarbox=0
# Optional diagnostic canvas color for unused physical pixels, six RGB hex
# digits. Leave commented for the normal black bars.

# Raspberry Pi legacy physical framebuffer/HDMI mode for the presenter.
framebuffer_hdmi_group=2
framebuffer_hdmi_mode=4
# For a custom legacy HDMI mode (normally mode 87), uncomment and provide the
# Raspberry Pi hdmi_cvt parameters validated for the connected monitor.
# framebuffer_hdmi_cvt=854 480 60 3 0 0 0
# A broadly compatible no-scaling letterbox experiment uses CEA 720p:
# framebuffer_hdmi_group=1
# framebuffer_hdmi_mode=4
# framebuffer_width=1280
# framebuffer_height=720
framebuffer_width=640
framebuffer_height=480
framebuffer_depth=16

# Logical launcher controls.
up_key=UP
down_key=DOWN
confirm_key=SPACE
