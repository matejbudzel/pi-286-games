# Host-specific launcher settings.
# Copy this file to config/host.conf and keep host.conf out of Git.

# Root directory containing the actual game binaries and assets.
game_data_root=~/pi-286-game-files

# Debian's package installs this command.
dosbox_command=dosbox

# Raspberry Pi 1 direct-console classic SDL 1.2 build. These are passed only
# to DOSBox; the DietPi installer creates the required installation first.
dosbox_ld_library_path=/opt/sdl12-fbcon/lib
dosbox_sdl_videodriver=fbcon
dosbox_sdl_fbdev=/dev/fb0
dosbox_sdl_fb_broken_modes=1

# Logical launcher controls.
up_key=UP
down_key=DOWN
confirm_key=SPACE
