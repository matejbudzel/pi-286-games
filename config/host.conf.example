# Host-specific launcher settings.
# Copy this file to config/host.conf and keep host.conf out of Git.

# Root directory containing the actual game binaries and assets.
game_data_root=/opt/pi-286-games-data

# Host-level panic input used while DOSBox is running.
# Development example: F1
# Raspberry Pi deployment: set this to the chosen dance-mat control.
# In the launcher menu, this key displays the Ethernet/Wi-Fi address (or offline).
panic_key=F1

# Linux event device for panic_key. This is the reliable path while DOSBox has
# the display (example: /dev/input/event0). Empty means all readable event
# devices are watched, which is convenient for UTM. The user must be in input.
panic_device=

# Debian's package installs this command.
dosbox_command=dosbox

# false closes the launcher and returns to the login shell. Set true on the
# Raspberry Pi appliance to power off the host from the Bye bye! menu item.
shutdown_on_bye_bye=false

# Logical launcher controls.
up_key=UP
down_key=DOWN
confirm_key=SPACE
