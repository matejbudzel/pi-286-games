# Host-specific launcher settings.
# Copy this file to config/host.conf and keep host.conf out of Git.

# Root directory containing the actual game binaries and assets.
game_data_root=/opt/pi-286-games-data

# Host-level panic input used while DOSBox is running.
# Development example: F1
# Raspberry Pi deployment: set this to the chosen dance-mat control.
panic_key=F1

# Logical launcher controls.
up_key=UP
down_key=DOWN
confirm_key=SPACE
