# Server-side settings for the Proxmox LXC. Keep the token in token_file.
bind=0.0.0.0
port=28680
state_root=/srv/pi286-stream
game_definitions_root=/opt/pi286-stream/repo/games
# Private, already extracted game directories; the server never downloads or
# unpacks them. Each game.conf data_dir is relative to this root.
game_data_root=/srv/pi286-games
token_file=/etc/pi286-stream.token
dosbox=/usr/bin/dosbox
xvfb=/usr/bin/Xvfb
# Xvfb exposes Xvfb_screen0 here. The backend uses stable direct reads for
# video capture and falls back to xwd if a frame changes while being read.
xvfb_fbdir=xvfb-fb
# Optional native x86_64 helper built by scripts/build-stream-capture-helper.sh.
# If absent or unstable, the Python/XGetImage fallback remains available.
capture_helper=/opt/pi286-stream/repo/streaming/backend/bin/pi286-xvfb-capture
xwd=/usr/bin/xwd
xdotool=/usr/bin/xdotool
# Keep file for the portable prototype. On a host with snd-aloop, use
# audio_capture=loopback and the Loopback playback/capture devices below.
arecord=/usr/bin/arecord
audio_capture=file
audio_playback_device=plughw:Loopback,0,0
audio_capture_device=hw:Loopback,1,0
audio_rate=22050
# Stop a session if its client stops polling/controlling it. WebSocket sessions
# also end immediately when their TCP connection closes.
session_idle_seconds=8
