# Host-local DOS streaming provider settings. Copy to provider.conf.
remote_dosbox_url=http://192.168.100.194:28680
remote_dosbox_token_file=~/.config/pi286-stream.token
remote_dosbox_presenter=/opt/pi286/stream/bin/pi286-stream-presenter
remote_dosbox_transport=websocket
# Pi-only native DOSBox 2x stream; requires a current stream server and presenter.
remote_dosbox_compression=zlib-2x
video_scaling=crt-lite
