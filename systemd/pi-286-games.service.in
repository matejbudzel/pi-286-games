[Unit]
Description=pi-286-games launcher on tty1
Wants=pi-286-games-audio.service
After=systemd-user-sessions.service pi-286-games-audio.service
Conflicts=getty@tty1.service
Before=getty@tty1.service

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@
Environment=HOME=@HOME@
Environment=TERM=linux
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
ExecStart=/usr/bin/python3 @REPO@/launcher/launcher.py --host-conf @REPO@/config/host.conf
# A normal launcher exit (including Ctrl-C) restores DietPi's tty1 getty. The
# non-blocking request avoids waiting on this unit's own stop job.
ExecStopPost=+/usr/bin/systemctl --no-block start getty@tty1.service
Restart=no

[Install]
WantedBy=multi-user.target
