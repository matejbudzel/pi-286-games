[Unit]
Description=Local relay for the DietPi Xpra development viewer
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 %h/work/own/pi-286-games/scripts/xpra-tcp-relay.py --target-host 127.0.0.1 --target-port 14501
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
