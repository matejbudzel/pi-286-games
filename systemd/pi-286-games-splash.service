[Unit]
Description=pi-286-games console boot splash
DefaultDependencies=no
After=systemd-vconsole-setup.service
Before=basic.target getty@tty1.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/pi-286-games/boot-splash.sh
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
