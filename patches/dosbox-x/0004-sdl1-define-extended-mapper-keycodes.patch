From: pi-286-games maintainers
Subject: [PATCH] mapper: provide SDL 1.2 keycodes absent from classic headers

DOSBox-X's Linux SDL1 mapper uses Japanese and keypad-comma key names that
are not present in classic SDL 1.2 headers. These keys are not used by the
Pi appliance, but the mapper table must compile. Keep the project-local
keycode assignments used by the non-Linux SDL1 mapper and map keypad comma to
the normal comma key.

---
 src/gui/sdl_mapper.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/gui/sdl_mapper.cpp b/src/gui/sdl_mapper.cpp
index 6c15474..380d99a 100644
--- a/src/gui/sdl_mapper.cpp
+++ b/src/gui/sdl_mapper.cpp
@@ -932,6 +932,15 @@ typedef char assert_right_size [MAX_SCANCODES == (sizeof(sdlkey_map)/sizeof(sdlk
 #elif defined (__linux__)
 #define MAX_SCANCODES 0x90
 #include "../../vs/sdl/include/SDL_keysym.h"
+#ifndef SDLK_JP_RO
+#define SDLK_JP_RO (SDLKey)0x73
+#endif
+#ifndef SDLK_JP_YEN
+#define SDLK_JP_YEN (SDLKey)0x7d
+#endif
+#ifndef SDLK_KP_COMMA
+#define SDLK_KP_COMMA SDLK_COMMA
+#endif
 static SDLKey sdlkey_map[MAX_SCANCODES] = { // Convert hardware scancode (XKB = evdev + 8) to SDL virtual keycode
     /* Refer to https://chromium.googlesource.com/chromium/src/+/lkgr/ui/events/keycodes/keyboard_code_conversion_x.cc */
     SDLK_UNKNOWN,//0x00
