 		for (y = y1; y < y2; ++y) {
-			SDL_memcpy(mapped_mem + mapped_offset + y * physlinebytes +
+			SDL_memcpy(mapped_mem + mapped_offset +
+			           (pillarbox_y + y) * physlinebytes +
 			           (pillarbox_x + x1) * 2,
 			           (Uint8 *)screen->pixels + y * screen->pitch + x1 * 2,
 			           (x2 - x1) * 2);
