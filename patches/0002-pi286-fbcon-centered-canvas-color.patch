+/* PI286_SDL_FB_PILLARBOX is deliberately limited to a centered RGB565 shadow
+   copy.  It is not a general scaling facility. */
+static int FB_PillarboxColor(const char *value, Uint8 *red, Uint8 *green,
+	Uint8 *blue)
+{
+	int digits[6];
+	int i;
+	if (SDL_strlen(value) != 6) return(0);
+	for (i = 0; i < 6; ++i) {
+		char c = value[i];
+		if (c >= '0' && c <= '9') digits[i] = c - '0';
+		else if (c >= 'a' && c <= 'f') digits[i] = c - 'a' + 10;
+		else if (c >= 'A' && c <= 'F') digits[i] = c - 'A' + 10;
+		else return(0);
+	}
+	*red = (Uint8)((digits[0] << 4) | digits[1]);
+	*green = (Uint8)((digits[2] << 4) | digits[3]);
+	*blue = (Uint8)((digits[4] << 4) | digits[5]);
+	return(1);
+}
+
+static void FB_PillarboxClear(_THIS)
+{
+	Uint16 *pixels = (Uint16 *)(mapped_mem + mapped_offset);
+	int count = (physlinebytes / 2) * cache_vinfo.yres;
+	while (count--) *pixels++ = pillarbox_fill;
+}
