+/* PI286_SDL_FB_PILLARBOX is deliberately limited to a same-height RGB565
+   shadow copy.  It is not a general scaling facility. */
+static void FB_PillarboxUpdate(_THIS, int numrects, SDL_Rect *rects)
+{
+	SDL_Surface *screen = this->screen;
+	int i;
+
+	if (switched_away) {
+		return;
+	}
+	for (i = 0; i < numrects; ++i) {
+		int x1 = rects[i].x;
+		int y1 = rects[i].y;
+		int x2 = x1 + rects[i].w;
+		int y2 = y1 + rects[i].h;
+		int y;
+		if (x1 < 0) x1 = 0;
+		if (y1 < 0) y1 = 0;
+		if (x2 > screen->w) x2 = screen->w;
+		if (y2 > screen->h) y2 = screen->h;
+		if (x2 <= x1 || y2 <= y1) continue;
+		for (y = y1; y < y2; ++y) {
+			SDL_memcpy(mapped_mem + mapped_offset + y * physlinebytes +
+			           (pillarbox_x + x1) * 2,
+			           (Uint8 *)screen->pixels + y * screen->pitch + x1 * 2,
+			           (x2 - x1) * 2);
+		}
+	}
+}
