#!/bin/sh
set -eu
script=$0
while [ -h "$script" ]; do
    directory=$(CDPATH= cd -- "$(dirname -- "$script")" && pwd)
    target=$(readlink "$script")
    case $target in
        /*) script=$target ;;
        *) script=$directory/$target ;;
    esac
done
root=$(CDPATH= cd -- "$(dirname -- "$script")/.." && pwd)
exec python3 "$root/provider.py" "$@"
